TUNNELMATE_DB=/var/lib/tunnelmate/control.db
TUNNELMATE_BROKER_SOCKET=/run/tunnelmate/broker.sock
TUNNELMATE_PUBLIC_HOST=tunnel.example.com
TUNNELMATE_BROKER_PORT=7000
TUNNELMATE_SECRET_KEY=replace-with-at-least-32-random-characters
TUNNELMATE_PRODUCTION=true
TUNNELMATE_SECURE_COOKIES=true
TUNNELMATE_ADMIN_USERNAME=operator
TUNNELMATE_ADMIN_PASSWORD=replace-at-install-and-remove-after-bootstrap
TUNNELMATE_API_HOST=127.0.0.1
TUNNELMATE_API_PORT=8000
