	cd /home/hamim-mahmud/Workspace/frpc-broker/build-sanitize && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
